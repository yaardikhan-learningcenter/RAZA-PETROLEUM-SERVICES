rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the Firebase users listed here can read or write the ERP data.
    match /erp/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['YOUR-EMAIL@gmail.com'];   // add more emails inside the [ ], separated by commas
    }
  }
}
